msgstr "قیمت عادی برای محصولات ساده و هر مدل جداگانۀ محصول قابل ویرایش است."

msgid "SKU"
msgstr "شناسهٔ کالا"

msgid "Save inventory"
msgstr "ذخیرهٔ موجودی"

msgid "Save price"
msgstr "ذخیرهٔ قیمت"

msgid "Save status"
msgstr "ذخیرهٔ وضعیت"

msgid "Save tracking code"
msgstr "ذخیرهٔ کد رهگیری"

msgid "Shipment"
msgstr "ارسال"

msgid "Shipment tracking updated in Dexo."
msgstr "رهگیری ارسال در دیکسو به‌روز شد."

msgid "Sign in · Dexo"
msgstr "ورود · دیکسو"

msgid "Sign out"
msgstr "خروج"

msgid "Skip to content"
msgstr "رفتن به محتوا"

msgid "Status"
msgstr "وضعیت"

