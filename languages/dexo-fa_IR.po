msgstr "وضعیت موجودی"

msgid "The note could not be saved."
msgstr "ذخیرهٔ یادداشت انجام نشد."

msgid "The order status could not be saved."
msgstr "ذخیرهٔ وضعیت سفارش انجام نشد."

msgid "The stock quantity could not be saved."
msgstr "ذخیرهٔ موجودی انجام نشد."

msgid "This page does not accept changes."
msgstr "تغییرات در این صفحه پذیرفته نمی‌شود."

msgid "This page is unavailable for your account."
msgstr "این صفحه برای حساب شما در دسترس نیست."

msgid "This product does not manage its own stock quantity."
msgstr "این محصول موجودی جداگانه ندارد."

msgid "This product has a sale price. Its regular price must stay above that price."
msgstr "این محصول قیمت ویژه دارد. قیمت عادی باید از آن بیشتر باشد."

msgid "This record is being updated. Try again in a moment."
msgstr "این مورد در حال به‌روزرسانی است. چند لحظهٔ دیگر دوباره تلاش کنید."

msgid "This status change is unavailable in Dexo."
msgstr "این تغییر وضعیت در دیکسو در دسترس نیست."

msgid "This stock status cannot be applied."
msgstr "ذخیرهٔ این وضعیت موجودی ممکن نیست."

msgid "This variation uses the parent product’s stock."
msgstr "این مدل از موجودی محصول مادر استفاده می‌کند."

msgid "Total"
msgstr "جمع"

msgid "Track shipment"
msgstr "پیگیری ارسال"

msgid "Tracking code"
msgstr "کد رهگیری"

msgid "Updated in Dexo."
msgstr "در دیکسو به‌روز شد."

msgid "Variations"
msgstr "مدل‌ها"

msgid "WooCommerce could not save the change. Reload the order and check its current state."
msgstr "ووکامرس نتوانست تغییر را ذخیره کند. سفارش را تازه کنید و وضعیت فعلی را بررسی کنید."

msgid "WooCommerce could not save the change. Reload the product and check its current state."
msgstr "ووکامرس نتوانست تغییر را ذخیره کند. محصول را تازه کنید و وضعیت فعلی را بررسی کنید."

msgid "WooCommerce is required"
msgstr "ووکامرس لازم است"

msgid "You cannot make this change."
msgstr "اجازهٔ این تغییر را ندارید."

msgid "Your form expired. Reload the page and try again."
msgstr "اعتبار فرم تمام شده است. صفحه را تازه کنید و دوباره تلاش کنید."
